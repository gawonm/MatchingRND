# Copy only missing entries into .env. Never commit .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=backend-secret-key
# psycopg uses Session pooler values, NOT the Data API secret key.
SUPABASE_DB_HOST=your-session-pooler-host
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password
RAG_BACKEND=supabase
RAG_EMBEDDING_DEVICE=auto
RAG_EMBEDDING_BATCH_SIZE=8
RFP_EMBEDDING_MODEL=dragonkue/BGE-m3-ko
LAW_EMBEDDING_MODEL=dragonkue/BGE-m3-ko
NTIS_EMBEDDING_MODEL=dragonkue/BGE-m3-ko
OPENAI_API_KEY=your-llm-key
# All LLM defaults use gpt-5.6-luna via app/common/llm_config.py.
RFP_RELEVANCE_BATCH_MODE=tokens
RFP_RELEVANCE_MAX_TOKENS=32000
RFP_RELEVANCE_BATCH_SIZE=5
# Keep full source and retrieval order; optional experiments are disabled.
RFP_RELEVANCE_CONTEXT_MODE=full
RFP_RELEVANCE_CANDIDATE_ORDER=retrieval
# NTIS extraction batching is experimental until coverage is validated.
NTIS_EXTRACTION_BATCH_SIZE=1
# Paid-call safeguards. SDK automatic retries are disabled by default.
OPENAI_REQUEST_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=0
QUERY_EXTRACTION_MAX_RETRIES=2
NTIS_EXTRACTION_MAX_RETRIES=0
